{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "name": "planr",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "planr_db",
      "database_name": "planr-db",
      "database_id": "0b611873-6281-4e56-bc6c-30be29658fef",
      "remote": true
    }
  ]
}
